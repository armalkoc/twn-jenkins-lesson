pipeline {
    agent any
    tools {
        maven "maven-3.9"
    }

    parameters {
        string(name: 'AppVersion', defaultValue: '', description: 'Specify application version')
    }

    stages {
        stage("build") {
            when {
                expression {
                    params.AppVersion == '3'
                }
            }
            steps {
                echo "Builidng Application number ${params.AppVersion} ..."

            }
        }

        stage("Test") {
            steps {
                echo "Testing application ..."

            }

        }

        stage("deploy") {
            steps {
                echo "Deployinh Application ..."
            }
        }
    }
}