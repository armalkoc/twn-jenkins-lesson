def grv 
pipeline {
    
    agent any
    tools {
        maven 'maven-3.9'
    }

    stages {
        stage("initialize grrovy script") {
            steps {
                script {
                    grv = load "amscript.groovy"
                }
            }
        }

        stage("build jar artifact") {
            steps {
                script {
                    grv.buildJar()
                }
            }
        }
        stage("build docker image") {
            steps {
                script {
                    grv.buildImage()
                    }
                }
            }
        }
        stage("deploy Docker Image") {
            steps {
                script {
                    grv.deployApp()
                    }
                }
        }
}
